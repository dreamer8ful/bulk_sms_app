<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_background_dark" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/neu_dark_shadow_dark" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/neu_light_shadow_dark" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
